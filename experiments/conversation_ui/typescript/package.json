{
  "name": "arbor-conversation-ui-comparison",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:shared": "node --test --test-reporter=tap tests/*.test.mjs",
    "test:renderers": "node --import tsx --test --test-reporter=tap web/renderer.test.tsx ink/renderer.test.tsx",
    "build:web": "esbuild web/main.tsx --bundle --outfile=web/dist/app.js --platform=browser --format=esm"
  },
  "dependencies": {
    "@assistant-ui/core": "0.3.21",
    "@assistant-ui/react": "0.15.22",
    "@assistant-ui/react-ink": "0.0.45",
    "ink": "7.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "ink-testing-library": "4.0.0",
    "jsdom": "30.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
