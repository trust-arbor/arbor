<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>{assigns[:page_title] || assigns[:app_name] || "Arbor"}</title>
    <link rel="stylesheet" href={assigns[:css_path] || "/assets/arbor_web.css"} />
    <%= if extra_css = assigns[:extra_css] do %>
      <link :for={css <- List.wrap(extra_css)} rel="stylesheet" href={css} />
    <% end %>
    <% client_assets = client_asset_paths() %>
    <link rel="modulepreload" href={client_assets.phoenix} crossorigin="anonymous" />
    <link rel="modulepreload" href={client_assets.phoenix_live_view} crossorigin="anonymous" />
    <script type="importmap">
      <%= Phoenix.HTML.raw(Jason.encode!(%{imports: client_assets})) %>
    </script>
    <script defer phx-track-static type="module" src={assigns[:js_path] || "/assets/arbor_web.js"}>
    </script>
    <%= if extra_js = assigns[:extra_js] do %>
      <script :for={js <- List.wrap(extra_js)} defer type="module" src={js}>
      </script>
    <% end %>
  </head>
  <body class="aw-body">
    {@inner_content}
  </body>
</html>
