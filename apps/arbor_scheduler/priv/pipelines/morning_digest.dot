// Reviewed local routine. Requires a newly reviewed v2 manifest; the bundled
// v1 manifest remains rejected. No signing or deployment activation is implied.
// Exact initial arguments:
// {"reports_directory":"reports","topics":["upstream-deps","upstream-deps-summary"]}
// Workdir: canonical pre-existing parent of the deployment's reports tree.
// The bounded action derives the current UTC date; no shell or LLM is involved.
digraph MorningDigest {
  graph [goal="Consolidate two local report topics for the current UTC date", label="Morning Digest"]
  start [shape=Mdiamond]
  build_digest [
    type="exec",
    target="action",
    action="reports.build_morning_digest",
    context_keys="reports_directory,topics",
    on_error="fail"
  ]
  done [shape=Msquare]
  start -> build_digest
  build_digest -> done
}
