# Arbor validation-runtime image (spawn-containment).
#
# ARG defaults for ERLANG_VERSION / ELIXIR_VERSION must match `.tool-versions`.
# Mix arbor.baseline.build fills lock/tree digest ARGs and platform.
# The Arbor Mix wrapper lives on the host and is bind-mounted at /arbor/bin/mix.
#
# Bump (keep ARG defaults matching `.tool-versions`):
# 1. Update erlang/elixir in `.tool-versions`.
# 2. Replace the FROM digest with the debian:bookworm-slim *index* digest
#    from docker-library/repo-info `repos/debian/remote/bookworm-slim.md`
#    (or `podman image inspect --format '{{index .RepoDigests 0}}'` after a
#    reviewed pull). Last pinned 2026-08-26: bookworm-20260824-slim.
# 3. Replace OTP_SRC_SHA256 from OTP SHA256.txt
#    (`otp_src_${ERLANG_VERSION}.tar.gz` on the matching GitHub release).
# 4. Replace ELIXIR_OTP_28_SHA256 from `elixir-otp-28.zip.sha256sum` on the
#    Elixir GitHub release for v<elixir version>.
#
# First-time operator preflight (builds use --pull=never and will not fetch
# the base image):
#
#     podman pull debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171

FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171

ARG ERLANG_VERSION=28.4.1
ARG ELIXIR_VERSION=1.19.5-otp-28
ARG OTP_SRC_SHA256=fb2aa0bd8d4118a275895d4a0ea5b24e40e9e1e27a7b29e001377d7660fd9ecf
ARG ELIXIR_OTP_28_SHA256=ca481510feb6dabc875bba43e44b25c7abafa53bd7a103639851b7aeace8a022
ARG ARBOR_VALIDATION_PLATFORM=linux/amd64
ARG MIX_LOCK_SHA256
ARG DEPS_TREE_SHA256

ENV LANG=C.UTF-8 \
    MIX_HOME=/usr/local/.mix \
    MIX_ARCHIVES=/usr/local/.mix/archives \
    ELIXIR_MAKE_CACHE_DIR=/usr/local/.cache/elixir_make \
    PATH=/usr/local/bin:/usr/local/lib/erlang/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      autoconf \
      build-essential \
      ca-certificates \
      curl \
      git \
      libncurses-dev \
      libssl-dev \
      linux-libc-dev \
      m4 \
      pkg-config=1.8.1-1 \
      pkgconf=1.8.1-1 \
      pkgconf-bin=1.8.1-1 \
      libpkgconf3=1.8.1-1 \
      unixodbc-dev \
      unzip \
      wget \
    && rm -rf /var/lib/apt/lists/*

# OTP prefix /usr/local installs the runtime at /usr/local/lib/erlang.
RUN curl -fsSL \
      "https://github.com/erlang/otp/releases/download/OTP-${ERLANG_VERSION}/otp_src_${ERLANG_VERSION}.tar.gz" \
      -o /tmp/otp.tar.gz \
    && echo "${OTP_SRC_SHA256}  /tmp/otp.tar.gz" | sha256sum -c - \
    && mkdir -p /tmp/otp \
    && tar -xzf /tmp/otp.tar.gz -C /tmp/otp --strip-components=1 \
    && cd /tmp/otp \
    && ./configure --prefix=/usr/local \
    && make -j"$(nproc)" \
    && make install \
    && rm -rf /tmp/otp /tmp/otp.tar.gz

# ELIXIR_VERSION is <version>-otp-28; the GitHub tag is v<version>.
RUN elixir_tag="$(printf '%s\n' "${ELIXIR_VERSION}" | cut -d- -f1)" \
    && curl -fsSL \
      "https://github.com/elixir-lang/elixir/releases/download/v${elixir_tag}/elixir-otp-28.zip" \
      -o /tmp/elixir.zip \
    && echo "${ELIXIR_OTP_28_SHA256}  /tmp/elixir.zip" | sha256sum -c - \
    && unzip /tmp/elixir.zip -d /usr/local \
    && rm -f /tmp/elixir.zip

RUN mkdir -p /usr/local/.mix/archives /usr/local/.cache/elixir_make \
    && mix local.hex --force \
    && mix local.rebar --force

# System.cmd/3 requires an executable, not the shell's built-in kill command.
# Keep runtime utilities late so adding them does not rebuild OTP and Elixir.
RUN apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && test -x /usr/bin/kill \
    && rm -rf /var/lib/apt/lists/*

# VP-07B0: Bundlex uses pkg-config only; Hex checksums cannot attest a
# secondary precompiled OS archive. Build the reviewed PortAudio release here.
ARG PORTAUDIO_SHA256=47efbf42c77c19a05d22e627d42873e991ec0c1357219c0d74ce6a2948cb2def
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      libasound2=1.2.8-1+b1 \
      libasound2-dev=1.2.8-1+b1 \
      libasound2-data=1.2.8-1 \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://files.portaudio.com/archives/pa_stable_v190700_20210406.tgz \
      -o /tmp/portaudio.tar.gz \
    && echo "${PORTAUDIO_SHA256}  /tmp/portaudio.tar.gz" | sha256sum -c - \
    && mkdir /tmp/portaudio \
    && tar -xzf /tmp/portaudio.tar.gz -C /tmp/portaudio --strip-components=1 \
    && cd /tmp/portaudio \
    && ./configure --prefix=/usr/local --without-jack --without-oss \
    && make -j"$(nproc)" \
    && make install \
    && ldconfig \
    && pkg-config --exists portaudio-2.0 \
    && rm -rf /tmp/portaudio /tmp/portaudio.tar.gz

# Existing locked NIF consumers also need their checksum-verified cache when a
# disposable dependency copy is compiled without networking. These hashes are
# from the locked packages' checksum.exs; PortAudio itself is built above.
RUN case "${ARBOR_VALIDATION_PLATFORM}" in \
      linux/arm64) native_arch=aarch64; \
        sqlite_sha=3c0aceec132bf3d465a39e8762879afb5407040d5f8df26956b7c51e1e44f2f3; \
        html_sha=4f432f842faa84273e879d503cb10e88f9a391606ef7a1a86502f14e3b93bc8a ;; \
      linux/amd64) native_arch=x86_64; \
        sqlite_sha=e3627fce78c2ce7f14fd5393e337e7997a1bd0d63390fecdb4b3b75f2d226d50; \
        html_sha=ee887e5fc01e4a534b5ab13caaaf2c5b978c84bb5cd40e11e75cfdaec683ea09 ;; \
      *) exit 1 ;; \
    esac \
    && sqlite_archive="exqlite-nif-2.17-${native_arch}-linux-gnu-0.34.0.tar.gz" \
    && html_archive="lazy_html-nif-2.16-${native_arch}-linux-gnu-0.1.8.tar.gz" \
    && curl -fsSL "https://github.com/elixir-sqlite/exqlite/releases/download/v0.34.0/${sqlite_archive}" \
      -o "${ELIXIR_MAKE_CACHE_DIR}/${sqlite_archive}" \
    && echo "${sqlite_sha}  ${ELIXIR_MAKE_CACHE_DIR}/${sqlite_archive}" | sha256sum -c - \
    && curl -fsSL "https://github.com/dashbitco/lazy_html/releases/download/v0.1.8/${html_archive}" \
      -o "${ELIXIR_MAKE_CACHE_DIR}/${html_archive}" \
    && echo "${html_sha}  ${ELIXIR_MAKE_CACHE_DIR}/${html_archive}" | sha256sum -c -

LABEL org.arbor.validation.schema="1" \
      org.arbor.validation.role="spawn-containment" \
      org.arbor.validation.platform="${ARBOR_VALIDATION_PLATFORM}" \
      org.arbor.validation.erlang="${ERLANG_VERSION}" \
      org.arbor.validation.elixir="${ELIXIR_VERSION}" \
      org.arbor.validation.portaudio="19.7.0" \
      org.arbor.validation.portaudio-source-sha256="${PORTAUDIO_SHA256}" \
      org.arbor.validation.pkgconf="1.8.1-1" \
      org.arbor.validation.alsa="1.2.8-1+b1" \
      org.arbor.validation.mix-lock-sha256="${MIX_LOCK_SHA256}" \
      org.arbor.validation.deps-tree-sha256="${DEPS_TREE_SHA256}"
