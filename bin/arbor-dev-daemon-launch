#!/bin/sh
# Trusted static launcher for `mix arbor.start`.
# Every dynamic value is a separately quoted positional argument.
# No eval, no free-form command string, no second parser of interpolated text.
#
# Usage:
#   arbor-dev-daemon-launch ELIXIR_ABS NAME_FLAG NODE COOKIE_HOME BIND_MODE BOOTSTRAP MIX_ABS LOG_ABS
#
# Backgrounds the fixed elixir/mix argv, redirects stdout/stderr to LOG, and
# prints the child OS PID on stdout for pre-readiness launch tracking.
set -eu
umask 077

if [ "$#" -ne 8 ]; then
  echo "arbor-dev-daemon-launch: expected 8 arguments, got $#" >&2
  exit 2
fi

ELIXIR=$1
NAME_FLAG=$2
NODE=$3
COOKIE_HOME=$4
BIND_MODE=$5
BOOTSTRAP=$6
MIX=$7
LOG=$8

if [ -z "$ELIXIR" ] || [ -z "$NAME_FLAG" ] || [ -z "$NODE" ] || [ -z "$COOKIE_HOME" ] || [ -z "$BIND_MODE" ] || [ -z "$BOOTSTRAP" ] || [ -z "$MIX" ] || [ -z "$LOG" ]; then
  echo "arbor-dev-daemon-launch: empty argument is not allowed" >&2
  exit 2
fi

case "$BIND_MODE" in
  loopback_v4)
    ERL_OPTIONS='-kernel inet_dist_use_interface {127,0,0,1} inet_dist_listen_min 9100 inet_dist_listen_max 9155 net_ticktime 120'
    ;;
  loopback_v6)
    ERL_OPTIONS='-kernel inet_dist_use_interface {0,0,0,0,0,0,0,1} inet_dist_listen_min 9100 inet_dist_listen_max 9155 net_ticktime 120'
    ;;
  default)
    ERL_OPTIONS='-kernel inet_dist_listen_min 9100 inet_dist_listen_max 9155 net_ticktime 120'
    ;;
  *)
    echo "arbor-dev-daemon-launch: invalid bind mode" >&2
    exit 2
    ;;
esac

# Ignore inherited VM flag channels: these are parsed before Elixir starts and
# could otherwise replace the fixed distribution policy above.
unset ERL_AFLAGS
unset ERL_FLAGS
unset ERL_ZFLAGS
unset ELIXIR_ERL_OPTIONS

# OTP reads the cookie from $HOME/.erlang.cookie while distribution boots.
# The required bootstrap restores the operator HOME before Mix evaluates
# runtime configuration or starts any Arbor application.
ARBOR_RUNTIME_ORIGINAL_HOME=$HOME
export ARBOR_RUNTIME_ORIGINAL_HOME
HOME=$COOKIE_HOME
export HOME

"$ELIXIR" "$NAME_FLAG" "$NODE" \
  --erl "$ERL_OPTIONS" \
  -r "$BOOTSTRAP" "$MIX" run --no-halt \
  >"$LOG" 2>&1 &

echo "$!"
