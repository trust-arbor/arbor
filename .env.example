# ============================================================================
# Arbor Environment Configuration
# Copy this file to .env and fill in the values you need.
# No values are required for basic setup with SQLite (ARBOR_DB=sqlite).
# ============================================================================

# --- Clustering / Distribution ---
# Required for `mix arbor.start` and all `mix arbor.*` commands.
# `mix arbor.setup` will auto-generate ARBOR_COOKIE if not set.
# ARBOR_COOKIE=                # Shared secret for Erlang distribution (required)
# ARBOR_NODE_HOST=             # This machine's IP or hostname for clustering
                               # Leave unset for local-only development (uses localhost)
                               # Examples: 10.42.42.101, myhost.local, myhost.tailnet.ts.net
# Distribution port range (9100-9155) is set automatically by `mix arbor.start`.
# For interactive use (iex -S mix), set: ERL_FLAGS="-kernel inet_dist_listen_min 9100 inet_dist_listen_max 9155"

# --- Database Adapter ---
# SQLite is the default (zero-config). Set ARBOR_DB=postgres for PostgreSQL.
# ARBOR_DB=postgres            # Use PostgreSQL (recommended for production)

# --- PostgreSQL (only if ARBOR_DB=postgres) ---
# DB_USER=arbor_dev
# DB_PASS=

# --- LLM Provider API Keys ---
# Recommended first run (free): OpenRouter — signup at https://openrouter.ai/keys
# Free models work with the built-in default (openai/gpt-oss-120b:free).
# OPENROUTER_API_KEY=
#
# GROQ_API_KEY=                # Free tier, OpenAI-compatible (https://console.groq.com)
# ANTHROPIC_API_KEY=           # Claude (direct)
# OPENAI_API_KEY=              # OpenAI/GPT (direct)
# GOOGLE_API_KEY=              # ReqLLM reads this for Gemini
# GEMINI_API_KEY=              # Alias — Arbor accepts either; propagates to ReqLLM
# XAI_API_KEY=                 # xAI/Grok
# ZAI_API_KEY=                 # Z.AI/GLM

# --- Local models (optional) ---
# ARBOR_OLLAMA_BASE_URL=http://localhost:11434
# LM_STUDIO_BASE_URL=http://localhost:1234/v1

# --- LLM Model Defaults (all optional; config.exs has sensible defaults) ---
# Providers: openrouter, groq, anthropic, openai, gemini, xai, zai, ollama, lmstudio
#
# ARBOR_DEFAULT_MODEL=openai/gpt-oss-120b:free
# ARBOR_DEFAULT_PROVIDER=openrouter
#
# Agent heartbeat (periodic thinking cycle — should be fast and cheap)
# ARBOR_HEARTBEAT_MODEL=openai/gpt-oss-120b:free
# ARBOR_HEARTBEAT_PROVIDER=openrouter
# ARBOR_IDLE_HEARTBEAT_MODEL=              # Defaults to ARBOR_HEARTBEAT_MODEL
#
# Context summarization (compresses conversation history)
# ARBOR_SUMMARIZER_MODEL=claude-haiku
# ARBOR_SUMMARIZER_PROVIDER=anthropic
#
# Advisory council (multi-perspective evaluation — 13 perspectives)
# ARBOR_COUNCIL_MODEL=openrouter:google/gemini-3-flash-preview
#
# Memory and reflection (knowledge graph operations)
# ARBOR_MEMORY_MODEL=anthropic:claude-sonnet-4-5-20250514
#
# Daily API spending limit in USD (default: 10.00)
# ARBOR_DAILY_BUDGET=10.00

# --- CLI Coding Agents (optional) ---
# Comma-separated list of CLI agent providers to try, in order.
# Requires the corresponding CLI tool installed (claude, codex, gemini, etc.)
# ARBOR_CLI_CHAIN=anthropic,openai,gemini,lmstudio

# --- Dashboard Auth (optional, required in production) ---
# DASHBOARD_USER=admin
# DASHBOARD_PASS=
# SECRET_KEY_BASE=             # Required in prod. Generate: mix phx.gen.secret

# --- OIDC Authentication (optional) ---
# Human identity for CLI + dashboard. Any OIDC provider works.
# For self-hosted Zitadel: see docker/zitadel/README.md
# OIDC_ISSUER=http://localhost:8080    # Provider issuer URL
# OIDC_CLIENT_ID=                      # Application client ID
# OIDC_CLIENT_SECRET=                  # Client secret (if confidential app)
# OIDC_SCOPES=openid,email,profile     # Comma-separated scopes
# OIDC_DEVICE_FLOW=true                # CLI device flow (default: true)
# OIDC_DEVICE_CLIENT_ID=               # Separate client ID for device flow (e.g. Zitadel Native app)

# --- Signal Messaging (optional) ---
# SIGNAL_FROM=+15551234567     # Your Signal account number
# SIGNAL_TO=+15551234567       # Owner's phone number
# SIGNAL_CLI_PATH=             # Path to signal-cli binary

# --- Limitless Pendant (optional) ---
# LIMITLESS_API_KEY=

# --- Email (optional) ---
# SMTP_USER=
# SMTP_PASS=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# EMAIL_TO=

# --- Contacts (optional) ---
# CONTACT_OWNER_EMAIL=you@example.com
# CONTACT_OWNER_SIGNAL=+15551234567
# CONTACT_OWNER_ALIASES=me,pendant
